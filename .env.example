# ==============================================================================
# Multi-Tenant Operations & Dispatch Engine - Environment Configuration
# ==============================================================================

# Server Configuration
PROJECT_NAME="Multi-Tenant Operations & Dispatch Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dispatch_engine"

# Sync Database URL for standard migrations (Alembic)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dispatch_engine"

# Security & Secrets
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
MASTER_ADMIN_API_KEY="master_admin_dev_key_change_me"

# External Integrations (Optional / Placeholders)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
HUBSPOT_API_KEY=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""

# Twilio Configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Stripe Configuration
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# CORS Settings (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"
